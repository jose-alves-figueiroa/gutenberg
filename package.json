{
  "name": "gutenberg",
  "version": "0.1.0",
  "description": "Liturgy projection for OBS",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "node scripts/dist-check.mjs && electron-vite build && electron-builder --mac --publish never",
    "dist:win": "node scripts/dist-check.mjs && electron-vite build && electron-builder --win --publish never",
    "dist:linux": "node scripts/dist-check.mjs && electron-vite build && electron-builder --linux --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "golden": "node scripts/gen-golden.mjs",
    "data:key": "node scripts/data-key.mjs key",
    "data:unlock": "node scripts/data-key.mjs unlock",
    "prebuild": "npm run data:unlock",
    "data:build": "tsx scripts/data-build.ts",
    "data:check": "tsx scripts/data-check.ts",
    "data:seed": "tsx scripts/gen-seed.ts",
    "translate:bible": "tsx scripts/translate-bible.ts",
    "translate:catechism": "tsx scripts/translate-catechism.ts",
    "translate:confession": "tsx scripts/translate-confession.ts",
    "holyrics:dump": "tsx scripts/holyrics-dump.ts",
    "translate:songs": "tsx scripts/translate-songs.ts",
    "translate:creeds": "tsx scripts/translate-creeds.ts",
    "translate:psalter": "tsx scripts/translate-psalter.ts",
    "hymnal:fetch": "tsx scripts/hymnal-fetch.ts",
    "translate:hymnal": "tsx scripts/translate-hymnal.ts",
    "release:notes": "tsx scripts/release-notes.ts"
  },
  "dependencies": {
    "@fontsource/source-serif-4": "^5.3.1",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.2",
    "electron-updater": "^6.8.9",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.7.0": true
  },
  "author": {
    "name": "José Ricardo Alves Figueirôa",
    "email": "josericardoaf@gmail.com"
  },
  "homepage": "https://github.com/jose-alves-figueiroa/gutenberg",
  "desktopName": "gutenberg.desktop"
}
