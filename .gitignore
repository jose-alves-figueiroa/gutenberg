# Dependencies and build
node_modules/
out/
dist/
release/
*.tsbuildinfo

# Tests / coverage
coverage/

# Generated databases (data:build) and raw sources — versioned data lives in data/canonical (git-crypt)
*.sqlite
*.sqlite3
*.db
!tests/fixtures/*.sqlite
data/sources/

# Machine-local config (OBS IP etc.)
.env
.env.*
!.env.example

# git-crypt key encrypted with GUTENBERG_DATA_PASSWORD (npm run data:key / data:unlock)
.secrets/
gutenberg.config.local.json

# Logs
*.log
npm-debug.log*

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Original handoff package (its content is in design_handoff_gutenberg/)
*.zip

# Local copies of third-party apps/data (Holyrics, ARA) — never commit
tmp/
