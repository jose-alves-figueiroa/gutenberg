.secrets/
gutenberg.config.local.json

# Logs
*.log
npm-debug.log*

# IDE / SO
.idea/
.vscode/
.DS_Store
Thumbs.db

# Pacote original do handoff (conteúdo já está em design_handoff_gutenberg/)
*.zip

