  "stanzas": [
    [
      "Oh! Como é bom e agradável,",
      "bem suave, sim,"
    ],
    [
      "quando os irmãos em harmonia",
      "vivem juntos, assim:"
    ],
    [
      "é como o óleo precioso",
      "sobre a fronte a correr,"
    ],
    [
      "é como o orvalho do Hermom",
      "que desce ao amanhecer."
    ]
  ],
